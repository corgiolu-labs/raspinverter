# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime data (SQLite history DB) — auto-creato al primo avvio
data/
*.db
*.db-wal
*.db-shm

# Config LIVE con taratura specifica dell'impianto — usare inverter_config.example.json come template
config/inverter_config.json

# Log
*.log

# Deroga: storico reale 2025 archiviato in old/ (le regole *.db sopra valgono
# per il runtime, non per questo snapshot che vogliamo conservare)
!old/storico-2025/
!old/storico-2025/*.db
!old/storico-2025/*.db-wal
!old/storico-2025/*.db-shm
